{
  "name": "malewich-app",
  "version": "0.1.0",
  "private": true,
  "description": "Малевич — ведение кальянов, полка и заявки для кальянной",
  "author": "Малевич",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:web": "VITE_WEB_ONLY=1 vite --host 127.0.0.1 --port 43127 --strictPort",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "dist:win": "vite build && electron-builder --win",
    "preview": "vite preview --host 127.0.0.1 --port 43127 --strictPort",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.2.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^35.2.1",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.3",
    "vite": "^6.3.4",
    "vite-plugin-electron": "^0.29.0",
    "vitest": "^3.1.2"
  },
  "build": {
    "appId": "ru.malevich.lounge",
    "productName": "Малевич",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  }
}
